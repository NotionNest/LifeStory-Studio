{
  "productName": "LifeStory Startup editor-lazy",
  "identifier": "dev.lifestory.studio.startup-matched-editor-lazy",
  "build": {
    "beforeBuildCommand": null,
    "frontendDist": "/tmp/lifestory-startup-bench/editor-lazy-dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "dragDropEnabled": false,
        "title": "LifeStory Studio",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": true,
        "backgroundColor": "#00000000",
        "windowEffects": {
          "effects": [
            "sidebar",
            "acrylic"
          ]
        },
        "trafficLightPosition": {
          "x": 16,
          "y": 22
        },
        "width": 1120,
        "height": 760,
        "minWidth": 760,
        "minHeight": 560,
        "alwaysOnTop": true,
        "focus": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost http://127.0.0.1:1438"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ]
  }
}