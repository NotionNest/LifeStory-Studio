{
  "name": "lifestory-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "check:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --tests",
    "check": "npm run typecheck && cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "test:ui": "vitest run",
    "codex:check": "node scripts/check-codex.mjs",
    "desktop:ci": "tauri build --debug --no-bundle --config src-tauri/tauri.ci.conf.json",
    "test:ci-policy": "node --test scripts/ci/policy.test.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tiptap/pm": "^3",
    "@tiptap/react": "^3",
    "@tiptap/starter-kit": "^3",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "lucide-react": "1.57.0",
    "radix-ui": "1.8.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "^2",
    "@types/node": "26.6.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "29.1.1",
    "shadcn": "4.21.5",
    "tailwindcss": "4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "5.0.4"
  },
  "engines": {
    "node": ">=24.3.0"
  }
}
