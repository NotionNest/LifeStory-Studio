{
  "name": "lifestory-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build -- --locked",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "check:rust": "cargo clippy --locked --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "test:rust": "cargo test --locked --manifest-path src-tauri/Cargo.toml --tests",
    "check": "npm run check:architecture && npm run lint && npm run format:check && npm run typecheck && cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "test:ui": "vitest run",
    "codex:check": "node scripts/check-codex.mjs",
    "desktop:ci": "tauri build --debug --no-bundle --config src-tauri/tauri.ci.conf.json -- --locked",
    "test:ci-policy": "node --test scripts/ci/policy.node.mjs",
    "format": "prettier --write src \"scripts/check-architecture*.mjs\" \"scripts/ci/policy{,.node}.mjs\" \"*.{ts,json}\" .prettierrc.json .github/workflows/check.yml eslint.config.mjs",
    "format:check": "prettier --check src \"scripts/check-architecture*.mjs\" \"scripts/ci/policy{,.node}.mjs\" \"*.{ts,json}\" .prettierrc.json .github/workflows/check.yml eslint.config.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "test:architecture": "node --test scripts/check-architecture.node.mjs",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "npm run lint -- --fix"
  },
  "dependencies": {
    "@shadcn/react": "0.3.1",
    "@tauri-apps/api": "^2",
    "@tiptap/pm": "^3",
    "@tiptap/react": "^3",
    "@tiptap/starter-kit": "^3",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.4.0",
    "date-fns": "4.4.0",
    "lucide-react": "1.57.0",
    "radix-ui": "1.8.1",
    "react": "^19.2.0",
    "react-day-picker": "10.0.2",
    "react-dom": "^19.2.0",
    "react-router": "8.5.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "^2",
    "@types/node": "26.6.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.10",
    "shadcn": "4.21.5",
    "tailwindcss": "4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "^8.0.16",
    "vitest": "5.0.4"
  },
  "engines": {
    "node": ">=24.3.0"
  }
}
